# Set locally as functions/.env.<firebase-project-id> (kept out of git).
# This must exactly match the deployed Netlify site origin. The admin page is
# path-based, so https://testportfolios01.netlify.app is its origin too.
CMS_ALLOWED_ORIGINS=https://testportfolios01.netlify.app

# Optional: defaults to us-central1. The same region is part of VITE_CMS_API_URL.
CMS_FUNCTION_REGION=us-central1
