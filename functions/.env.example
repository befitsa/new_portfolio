# Set locally as functions/.env.<firebase-project-id> (kept out of git).
# CF Access team hostname, e.g. fitsum.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Audience tag for the Access application protecting admin.example.com/api/*
CF_ACCESS_AUD=
# Exact admin origin(s), comma-separated; these are CORS values, not security credentials.
CMS_ALLOWED_ORIGINS=https://admin.example.com
# Local emulator only; leave false/unset in production. The Function checks both
# this flag and an emulator process + a localhost Origin before bypassing Access.
CMS_ALLOW_LOCAL_EMULATOR=false
# Optional: defaults to us-central1
CMS_FUNCTION_REGION=us-central1
