# Copy this file to .env and fill it in.
#
# URL of YOUR backend endpoint that receives the contact form (POST, JSON body:
# { name, email, subject, message }) and sends the email server-side.
# Never put email-service secrets in a VITE_ variable — everything starting
# with VITE_ is visible to anyone who opens the site's JavaScript.
VITE_CONTACT_API_URL=
