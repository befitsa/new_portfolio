# Copy this file to .env and fill it in.
#
# URL of YOUR backend endpoint that receives the contact form (POST, JSON body:
# { name, email, subject, message }) and sends the email server-side.
# Never put email-service secrets in a VITE_ variable — everything starting
# with VITE_ is visible to anyone who opens the site's JavaScript.
VITE_CONTACT_API_URL=

# Admin hostname in development: http://dev.localhost:5173/
# Change to "admin" to use http://admin.localhost:5173/
VITE_ADMIN_SUBDOMAIN=dev

# Existing portfolio/content Firebase app configuration. Keep these values
# pointed at the project that owns the current portfolio data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web API key for the separate admin Authentication app in user-auth-vp.
# Copy the Web API key from Firebase Console > Project settings > Your apps.
# This is a public Firebase app identifier, not a service-account credential.
VITE_ADMIN_FIREBASE_API_KEY=

# Local Firebase emulators only. Enable after configuring their endpoints.
VITE_USE_FIREBASE_EMULATORS=false

# Optional local development endpoint (for example, the Functions emulator URL).
# Production always uses the same-origin Netlify /api function proxy.
VITE_CMS_API_URL=

# Defaults to local JSON + disk uploads for `npm run dev`.
# Set to "remote" only when explicitly testing a protected remote/emulator CMS API.
VITE_CMS_PROVIDER=local

# Public site URL in production (for example https://portfolio.example.com/)
VITE_PUBLIC_PORTFOLIO_URL=
