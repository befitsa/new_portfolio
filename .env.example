# Copy this file to .env and fill in the values for your deployment.
#
# Public browser configuration only. Never put a Supabase service-role key,
# database password, or email-service secret in a VITE_ variable.
VITE_SUPABASE_URL=https://bupageguxdvphaebvdoa.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site URL in production (for example https://portfolio.example.com/)
VITE_PUBLIC_PORTFOLIO_URL=

# Optional server-side contact form endpoint.
VITE_CONTACT_API_URL=

# Admin hostname in development: http://dev.localhost:5173/
# Change to "admin" to use http://admin.localhost:5173/
VITE_ADMIN_SUBDOMAIN=dev
