# Public Firebase web app key used only by the existing administrator sign-in.
VITE_ADMIN_FIREBASE_API_KEY=
# Mirror the server allowlist here if you deliberately add another admin UID.
VITE_ADMIN_UIDS=

# Netlify Function runtime variables. Add these in Netlify site settings too.
# Generate a service account for the user-auth-vp project and paste its JSON
# as one line. Keep this value server-side; never rename it with a VITE_ prefix.
FIREBASE_PROJECT_ID=user-auth-vp
FIREBASE_SERVICE_ACCOUNT_JSON=
CMS_ADMIN_UIDS=

# Cloudinary API credentials (authenticated delivery is used for private drafts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated production/preview origins allowed for protected writes.
ALLOWED_ORIGINS=

# Optional existing contact form service endpoint.
VITE_CONTACT_API_URL=
