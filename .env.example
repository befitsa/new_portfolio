# Public Firebase web app key used by the administrator sign-in.
VITE_ADMIN_FIREBASE_API_KEY=

# Mirror the server-side administrator UID allowlist for the frontend route guard.
VITE_ADMIN_UIDS=

# Optional separate public-site URL when the admin is deployed on another host.
VITE_PUBLIC_PORTFOLIO_URL=

# Optional admin subdomain prefix when public and admin sites share a domain.
VITE_ADMIN_SUBDOMAIN=

# Optional existing contact form service endpoint.
VITE_CONTACT_API_URL=
